# Client-side (exposed to the browser via Vite's VITE_ prefix)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-side (never prefix these with VITE_ — they must not reach the client bundle)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# To enable "Sign in with Google" on /auth (see src/routes/auth.tsx):
# 1. Create an OAuth client in Google Cloud Console.
# 2. In your Supabase project: Authentication -> Providers -> Google, paste the
#    client ID/secret there.
# 3. Set the redirect URI in Google Cloud Console to:
#    https://<your-project-ref>.supabase.co/auth/v1/callback
# No app-side env var needed for this — it's configured entirely in Supabase.
