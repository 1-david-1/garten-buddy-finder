# Client-side (exposed to the browser via Vite's VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side (never prefix these with VITE_ — they must not reach the client bundle)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_here

# Resend Email Service (Server-only – ohne diese Variablen schlägt Eltern-Einladung fehl)
# 1) API-Key: https://resend.com/api-keys
# 2) Domain in Resend verifizieren, dann Absender mit dieser Domain setzen
#    Test ohne eigene Domain: EMAIL_FROM_ADDRESS=GreenMatch <onboarding@resend.dev>
#    (Resend liefert dann nur an die E-Mail des Resend-Kontos zu)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_ADDRESS=GreenMatch <noreply@mail.your-domain.de>
EMAIL_REPLY_TO=support@your-domain.de
PUBLIC_SITE_URL=http://localhost:3000
